<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Loan" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:error id="Error_CreditApi" name="Credit API Error" errorCode="CREDIT_API_ERROR" />
  <bpmn:process id="loan-approval-process" name="Loan Approval Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Application" name="Loan application received">
      <bpmn:extensionElements><zeebe:formDefinition formId="loan-application-form" /></bpmn:extensionElements><bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Validate" name="Validate applicant (Spring Boot worker)">
      <bpmn:extensionElements><zeebe:taskDefinition type="validate-applicant" retries="3" /></bpmn:extensionElements><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Valid" name="Application valid?" default="F3"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F_Invalid</bpmn:outgoing><bpmn:outgoing>F3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CreditCheck" name="Credit assessment (REST connector)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="9">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="post" target="method" />
          <zeebe:input source="http://localhost:8081/api/credit-assessment" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={applicantId: applicantId, loanAmount: loanAmount, monthlyIncome: monthlyIncome}" target="body" />
          <zeebe:input source="5" target="connectionTimeoutInSeconds" />
          <zeebe:input source="10" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={creditScore: response.body.creditScore, riskLevel: response.body.riskLevel, reportId: response.body.reportId}" />
          <zeebe:header key="errorExpression" value="=if response.status &gt;= 400 then bpmnError(&#34;CREDIT_API_ERROR&#34;, &#34;Credit API returned HTTP &#34; + string(response.status)) else null" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_CreditError" name="Credit API error" attachedToRef="Task_CreditCheck"><bpmn:outgoing>F_ApiError</bpmn:outgoing><bpmn:errorEventDefinition id="ErrDef_1" errorRef="Error_CreditApi" /></bpmn:boundaryEvent>
    <bpmn:businessRuleTask id="Task_Decision" name="Evaluate loan decision (DMN)">
      <bpmn:extensionElements><zeebe:calledDecision decisionId="loan_decision" resultVariable="decisionResult" /></bpmn:extensionElements><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_Decision" name="DMN decision?" default="F_Manual"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F_Approved</bpmn:outgoing><bpmn:outgoing>F_Rejected</bpmn:outgoing><bpmn:outgoing>F_Manual</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManualReview" name="Manual review">
      <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="manual-review-form" /></bpmn:extensionElements><bpmn:incoming>F_Manual</bpmn:incoming><bpmn:incoming>F_ApiError</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Review" name="Reviewer decision?" default="F_RevReject"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F_RevApprove</bpmn:outgoing><bpmn:outgoing>F_RevReject</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_SetApproved" name="Record Approved">
      <bpmn:extensionElements><zeebe:script expression="=&#34;Approved&#34;" resultVariable="finalDecision" /></bpmn:extensionElements><bpmn:incoming>F_Approved</bpmn:incoming><bpmn:incoming>F_RevApprove</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_SetRejected" name="Record Rejected">
      <bpmn:extensionElements><zeebe:script expression="=&#34;Rejected&#34;" resultVariable="finalDecision" /></bpmn:extensionElements><bpmn:incoming>F_Invalid</bpmn:incoming><bpmn:incoming>F_Rejected</bpmn:incoming><bpmn:incoming>F_RevReject</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Approved" name="Loan approved"><bpmn:incoming>F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_Rejected" name="Loan rejected"><bpmn:incoming>F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="StartEvent_Application" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Validate" targetRef="GW_Valid" />
    <bpmn:sequenceFlow id="F_Invalid" name="Invalid" sourceRef="GW_Valid" targetRef="Task_SetRejected"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=validationPassed = false</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F3" name="Valid" sourceRef="GW_Valid" targetRef="Task_CreditCheck" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_CreditCheck" targetRef="Task_Decision" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Decision" targetRef="GW_Decision" />
    <bpmn:sequenceFlow id="F_Approved" name="Approved" sourceRef="GW_Decision" targetRef="Task_SetApproved"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=decisionResult.decision = &#34;Approved&#34;</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Rejected" name="Rejected" sourceRef="GW_Decision" targetRef="Task_SetRejected"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=decisionResult.decision = &#34;Rejected&#34;</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Manual" name="Manual Review" sourceRef="GW_Decision" targetRef="Task_ManualReview" />
    <bpmn:sequenceFlow id="F_ApiError" name="API error" sourceRef="Boundary_CreditError" targetRef="Task_ManualReview" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_ManualReview" targetRef="GW_Review" />
    <bpmn:sequenceFlow id="F_RevApprove" name="Approve" sourceRef="GW_Review" targetRef="Task_SetApproved"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=reviewerDecision = &#34;Approve&#34;</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_RevReject" name="Reject" sourceRef="GW_Review" targetRef="Task_SetRejected" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_SetApproved" targetRef="End_Approved" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_SetRejected" targetRef="End_Rejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="loan-approval-process">
      <bpmndi:BPMNShape id="StartEvent_Application_di" bpmnElement="StartEvent_Application"><dc:Bounds x="152" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="122" y="222" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate"><dc:Bounds x="240" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Valid_di" bpmnElement="GW_Valid" isMarkerVisible="true"><dc:Bounds x="395" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="370" y="145" width="100" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreditCheck_di" bpmnElement="Task_CreditCheck"><dc:Bounds x="500" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_CreditError_di" bpmnElement="Boundary_CreditError"><dc:Bounds x="532" y="222" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="502" y="262" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Decision_di" bpmnElement="Task_Decision"><dc:Bounds x="660" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Decision_di" bpmnElement="GW_Decision" isMarkerVisible="true"><dc:Bounds x="785" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="760" y="145" width="100" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManualReview_di" bpmnElement="Task_ManualReview"><dc:Bounds x="1000" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Review_di" bpmnElement="GW_Review" isMarkerVisible="true"><dc:Bounds x="1185" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1160" y="145" width="100" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SetApproved_di" bpmnElement="Task_SetApproved"><dc:Bounds x="1310" y="60" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SetRejected_di" bpmnElement="Task_SetRejected"><dc:Bounds x="1310" y="320" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Approved_di" bpmnElement="End_Approved"><dc:Bounds x="1452" y="82" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1422" y="122" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected"><dc:Bounds x="1452" y="342" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1422" y="382" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="188" y="200" /><di:waypoint x="240" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="340" y="200" /><di:waypoint x="395" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Invalid_di" bpmnElement="F_Invalid"><di:waypoint x="420" y="225" /><di:waypoint x="420" y="440" /><di:waypoint x="1360" y="440" /><di:waypoint x="1360" y="400" /><bpmndi:BPMNLabel><dc:Bounds x="425" y="230" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="445" y="200" /><di:waypoint x="500" y="200" /><bpmndi:BPMNLabel><dc:Bounds x="455" y="182" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="600" y="200" /><di:waypoint x="660" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="760" y="200" /><di:waypoint x="785" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Approved_di" bpmnElement="F_Approved"><di:waypoint x="810" y="175" /><di:waypoint x="810" y="100" /><di:waypoint x="1310" y="100" /><bpmndi:BPMNLabel><dc:Bounds x="815" y="180" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Rejected_di" bpmnElement="F_Rejected"><di:waypoint x="810" y="225" /><di:waypoint x="810" y="360" /><di:waypoint x="1310" y="360" /><bpmndi:BPMNLabel><dc:Bounds x="815" y="230" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Manual_di" bpmnElement="F_Manual"><di:waypoint x="835" y="200" /><di:waypoint x="1000" y="200" /><bpmndi:BPMNLabel><dc:Bounds x="840" y="205" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ApiError_di" bpmnElement="F_ApiError"><di:waypoint x="550" y="258" /><di:waypoint x="550" y="300" /><di:waypoint x="1050" y="300" /><di:waypoint x="1050" y="240" /><bpmndi:BPMNLabel><dc:Bounds x="555" y="263" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1100" y="200" /><di:waypoint x="1185" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_RevApprove_di" bpmnElement="F_RevApprove"><di:waypoint x="1235" y="200" /><di:waypoint x="1360" y="200" /><di:waypoint x="1360" y="140" /><bpmndi:BPMNLabel><dc:Bounds x="1240" y="205" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_RevReject_di" bpmnElement="F_RevReject"><di:waypoint x="1210" y="225" /><di:waypoint x="1210" y="360" /><di:waypoint x="1310" y="360" /><bpmndi:BPMNLabel><dc:Bounds x="1215" y="230" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1410" y="100" /><di:waypoint x="1452" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1410" y="360" /><di:waypoint x="1452" y="360" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
